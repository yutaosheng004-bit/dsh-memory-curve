{
  "name": "dsh-memory-curve",
  "version": "1.1.1",
  "description": "四层记忆插件 for DeepSeek Harness（长期 / 短期 / 原文窗口 / 存档检索，移植自 astrbot_plugin_memory_curve）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "scripts/patch-profile.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/host-sim.mjs && node test/panel.mjs && node test/panel-live.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:host": "node test/host-sim.mjs",
    "test:panel": "node test/panel.mjs",
    "test:panel-live": "node test/panel-live.mjs",
    "patch": "node scripts/patch-profile.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "recall"
  ],
  "author": "宅家大肥鱼",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutaosheng004-bit/dsh-memory-curve.git"
  }
}